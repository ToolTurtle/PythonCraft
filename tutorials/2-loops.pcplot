,14,18,1,16,19,1,9,19,1,11,19,1,13,19,1,15,20,1,10,20,1,12,20,1,14,20,1,16],"white_wool":[13,1,10,13,1,12,13,1,14,13,1,16,14,1,9,14,1,11,14,1,13,14,1,15,15,1,10,15,1,12,15,1,14,15,1,16,16,1,9,16,1,11,16,1,13,16,1,15,17,1,10,17,1,12,17,1,14,17,1,16,18,1,9,18,1,11,18,1,13,18,1,15,19,1,10,19,1,12,19,1,14,19,1,16,20,1,9,20,1,11,20,1,13,20,1,15],"sandstone":[26,1,9,26,1,10,26,1,11,26,1,12,26,1,13,26,1,14,26,1,15,27,1,9,27,1,10,27,1,11,27,1,12,27,1,13,27,1,14,27,1,15,28,1,9,28,1,10,28,1,11,28,1,12,28,1,13,28,1,14,28,1,15,29,1,9,29,1,10,29,1,11,29,1,12,29,1,13,29,1,14,29,1,15,30,1,9,30,1,10,30,1,11,30,1,12,30,1,13,30,1,14,30,1,15,31,1,9,31,1,10,31,1,11,31,1,12,31,1,13,31,1,14,31,1,15,32,1,9,32,1,10,32,1,11,32,1,12,32,1,13,32,1,14,32,1,15,27,2,10,27,2,11,27,2,12,27,2,13,27,2,14,28,2,10,28,2,11,28,2,12,28,2,13,28,2,14,29,2,10,29,2,11,29,2,12,29,2,13,29,2,14,30,2,10,30,2,11,30,2,12,30,2,13,30,2,14,31,2,10,31,2,11,31,2,12,31,2,13,31,2,14,28,3,11,28,3,12,28,3,13,29,3,11,29,3,12,29,3,13,30,3,11,30,3,12,30,3,13,29,4,12]},"facing":[[6,1,5,"south"],[17,1,5,"south"],[29,1,5,"south"],[44,1,5,"south"]],"mobs":[["villager",4,1,2]],"signs":[[6,1,5,["A staircase\nfor i in range(8) repeats the indented line 8 times, with i = 0, 1, 2, ...","for i in range(8):\n    w.placeblock(2 + i, 1 + i, 9, 'cobblestone')"]],[17,1,5,["A checkerboard\nTwo loops: one for x and one for z. if/else picks the block.","for x in range(8):\n    for z in range(8):\n        if (x + z) % 2 == 0:\n            w.placeblock(13 + x, 1, 9 + z, 'stone')\n        else:\n            w.placeblock(13 + x, 1, 9 + z, 'white_wool')"]],[29,1,5,["A pyramid\nOne fill() for each layer. Each layer is 2 smaller than the one below.","for i in range(4):\n    size = 7 - 2 * i\n    w.fill(26 + i, 1 + i, 9 + i, 26 + i + size - 1, 1 + i, 9 + i + size - 1, 'sandstone')"]],[44,1,5,["A ring\nMaths in a loop: sin and cos place things round a circle.","import math\nfor k in range(12):\n    x = round(44 + 5 * math.cos(k * math.pi / 6))\n    z = round(13 + 5 * math.sin(k * math.pi / 6))\n    w.fill(x, 1, z, x, 4, z, 'stone_bricks')"]]],"npcs":[{"kind":"villager","pos":[4,1,2],"name":"Guide","lines":["Welcome to Tutorial 2: Loops!","A loop repeats lines of code.","Each exhibit here was built with a loop. Read the signs."]}],"settings":{"time":"day","cycle":false,"weather":"clear","music":true,"start":[5,1,-3]},"tutorial":{"level":2,"summary":"Let the computer repeat things: stairs, a checkerboard, a pyramid and a ring.","steps":["Walk east along the exhibits and read each sign.","Look at how few lines of code build something big."],"try_it":["Change range(8) to range(12) in the staircase.","Use three different blocks in the checkerboard.","Make the pyramid one layer taller."],"code":"import pycraft as pc\n\nw = pc.plot(52, 14, 24)\nw.fill(0, 0, 0, 51, 0, 23, \"grass\")\n# A staircase: for i in range(8) repeats the indented line 8 times, with i = 0, 1, 2, ...\nfor i in range(8):\n    w.placeblock(2 + i, 1 + i, 9, 'cobblestone')\n# A checkerboard: Two loops: one for x and one for z. if/else picks the block.\nfor x in range(8):\n    for z in range(8):\n        if (x + z) % 2 == 0:\n            w.placeblock(13 + x, 1, 9 + z, 'stone')\n        else:\n            w.placeblock(13 + x, 1, 9 + z, 'white_wool')\n# A pyramid: One fill() for each layer. Each layer is 2 smaller than the one below.\nfor i in range(4):\n    size = 7 - 2 * i\n    w.fill(26 + i, 1 + i, 9 + i, 26 + i + size - 1, 1 + i, 9 + i + size - 1, 'sandstone')\n# A ring: Maths in a loop: sin and cos place things round a circle.\nimport math\nfor k in range(12):\n    x = round(44 + 5 * math.cos(k * math.pi / 6))\n    z = round(13 + 5 * math.sin(k * math.pi / 6))\n    w.fill(x, 1, z, x, 4, z, 'stone_bricks')\n\npc.runplot(w, pc.adventure)\n"},"meta":{}}