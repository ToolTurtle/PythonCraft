{"format":"pcchallenge","version":1,"id":"skyline","title":"Touch the clouds","brief":"Build a tower at least 15 blocks tall, with a window, at least two torches and at least two different kinds of block.","size":[24,24,24],"checks":[{"type":"tallest","min":15,"label":null},{"type":"block_count","block":["glass","glass_pane"],"min":1,"max":null,"label":"has a window"},{"type":"block_count","block":["torch"],"min":2,"max":null,"label":"has at least 2 torches"},{"type":"kinds","min":2,"each":10,"label":null}],"points":10,"hints":["A loop makes tall towers easy: for y in range(15): ..."],"author":""}